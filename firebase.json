{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "PRODUCT.md",
      "DESIGN.md",
      ".impeccable/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "**/*.@(js|css|svg|jpg|webp|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  }
}
